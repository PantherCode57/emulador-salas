+GuiPantherWifi::GuiPantherWifi(Window* window) : GuiComponent(window),
+	mAlive(std::make_shared<bool>(true)), mBusy(false), mMessageTime(0), mLoaded(false), mCursor(-1), mScroll(0), mBackground(nullptr)
+{
+	const float W = (float)Renderer::getScreenWidth();
+	const float H = (float)Renderer::getScreenHeight();
+	setSize(W, H);
+
+	mFontTitle = Font::get((int)(H * 0.065f), FONT_PATH_REGULAR);
+	mFontName = Font::get((int)(H * 0.044f), FONT_PATH_REGULAR);
+	mFontSmall = Font::get((int)(H * 0.032f), FONT_PATH_REGULAR);
+	mFontLabel = Font::get((int)(H * 0.029f), FONT_PATH_REGULAR);
+
+	std::string fondo = Settings::getInstance()->getString("PantherWifiBackground");
+	if (!fondo.empty() && Utils::FileSystem::exists(fondo))
+	{
+		mBackground = new ImageComponent(window, false);
+		mBackground->setImage(fondo);
+		mBackground->setOrigin(0, 0);
+		mBackground->setPosition(0, 0);
+		mBackground->setResize(W, H);
+	}
+
+	refresh(false);
+}
+
+GuiPantherWifi::~GuiPantherWifi()
+{
+	*mAlive = false;
+	delete mBackground;
+}
+
+void GuiPantherWifi::showMessage(const std::string& text, int ms)
+{
+	mMessage = text;
+	mMessageTime = ms;
+}
+
+void GuiPantherWifi::runJob(const std::string& busyText, bool rescan, const std::function<bool()>& work, const std::function<void(bool)>& done)
+{
+	if (mBusy)
+		return;
+
+	mBusy = true;
+	mBusyText = busyText;
+
+	Window* window = mWindow;
+	auto alive = mAlive;
+	std::thread([this, window, alive, rescan, work, done]()
+	{
+		bool ok = work ? work() : true;
+		Estado estado = leerEstado(rescan);
+
+		// «this» sólo se usa en el hilo del menú y si la pantalla sigue abierta
+		window->postToUiThread([this, alive, ok, estado, done](Window*)
+		{
+			if (!*alive)
+				return;
+
+			mBusy = false;
+			mBusyText.clear();
+			applyEstado(estado);
+
+			if (done)
+				done(ok);
+		});
+	}).detach();
+}
+
+void GuiPantherWifi::applyEstado(const Estado& estado)
+{
+	bool first = !mLoaded;
+
+	std::string sel;
+	if (mCursor >= 0 && mCursor < (int)mEstado.redes.size())
+		sel = mEstado.redes[mCursor].ssid;
+
+	mEstado = estado;
+	mLoaded = true;
+
+	int count = (int)mEstado.redes.size();
+	if (mCursor >= 0)
+	{
+		int found = -1;
+		for (int i = 0; i < count; i++)
+			if (mEstado.redes[i].ssid == sel)
+				found = i;
+
+		mCursor = found >= 0 ? found : std::min(mCursor, count - 1);
+	}
+
+	if (first && count > 0)
+		mCursor = 0;
+
+	mScroll = std::max(0, std::min(mScroll, count - 1));
+}
+
+void GuiPantherWifi::refresh(bool rescan)
+{
+	runJob(rescan ? "Buscando redes…" : (mLoaded ? "Actualizando…" : "Buscando redes…"), rescan, nullptr, nullptr);
+}
+
+void GuiPantherWifi::toggle()
+{
+	bool enable = !mEstado.enabled;
+	runJob(enable ? "Encendiendo el Wi-Fi…" : "Apagando el Wi-Fi…", enable, [enable]()
+	{
+		WifiManager::toggleWifi(enable);
+		if (enable)
+			std::this_thread::sleep_for(std::chrono::seconds(4));
+
+		runOk("touch /tmp/es-wifi-changed");
+		return true;
+	}, nullptr);
+}
+
+void GuiPantherWifi::connect(const Red& red)
+{
+	if (red.saved)
+	{
+		std::string ssid = red.ssid;
+		bool secure = red.secure;
+		runJob("Conectando a " + corta(ssid, 18) + "…", false, [ssid]()
+		{
+			bool ok = runOk("sudo nmcli --wait 25 connection up id " + q(ssid));
+			runOk("touch /tmp/es-wifi-changed");
+			return ok;
+		}, [this, ssid, secure](bool ok)
+		{
+			if (ok)
+				showMessage("Conectado a " + corta(ssid, 24));
+			else if (secure)
+			{
+				showMessage("No se pudo conectar. Escribe otra vez la contraseña.");
+				askPassword(ssid, true);
+			}
+			else
+				showMessage("No se pudo conectar a " + corta(ssid, 24));
+		});
+		return;
+	}
+
+	if (!red.secure)
+	{
+		connectWithPassword(red.ssid, "", false);
+		return;
+	}
+
+	askPassword(red.ssid, false);
+}
+
+void GuiPantherWifi::askPassword(const std::string& ssid, bool replaceSaved)
+{
+	auto alive = mAlive;
+	mWindow->pushGui(new GuiTextEditPopupKeyboard(mWindow, "Contraseña de " + corta(ssid, 20), "", [this, alive, ssid, replaceSaved](const std::string& password)
+	{
+		if (!*alive)
+			return;
+
+		if (password.size() < 8)
+		{
+			showMessage("La contraseña tiene que tener al menos 8 letras o números");
+			return;
+		}
+
+		connectWithPassword(ssid, password, replaceSaved);
+	}, false, "CONECTAR"));
+}
+
+void GuiPantherWifi::connectWithPassword(const std::string& ssid, const std::string& password, bool replaceSaved)
+{
+	runJob("Conectando a " + corta(ssid, 18) + "…", false, [ssid, password, replaceSaved]()
+	{
+		if (replaceSaved)
+			runOk("sudo nmcli connection delete id " + q(ssid));
+
+		std::string cmd = "sudo nmcli --wait 30 device wifi connect " + q(ssid);
+		if (!password.empty())
+			cmd += " password " + q(password);
+
+		bool ok = runOk(cmd);
+		if (!ok)
+			runOk("sudo nmcli connection delete id " + q(ssid)); // no dejar una red guardada a medias
+
+		runOk("touch /tmp/es-wifi-changed");
+		return ok;
+	}, [this, ssid](bool ok)
+	{
+		showMessage(ok ? "Conectado a " + corta(ssid, 24) : "No se pudo conectar. Revisa la contraseña.");
+	});
+}
+
+void GuiPantherWifi::forget()
+{
+	if (mEstado.activeName.empty())
+		return;
+
+	std::string name = mEstado.activeName;
+	auto alive = mAlive;
+	mWindow->pushGui(new GuiMsgBox(mWindow, "¿Olvidar la red " + corta(name, 24) + "?\nPara volver a usarla tendrás que escribir la contraseña.",
+		"OLVIDAR", [this, alive, name]()
+		{
+			if (!*alive)
+				return;
+
+			runJob("Olvidando " + corta(name, 18) + "…", false, [name]()
+			{
+				bool ok = runOk("sudo nmcli connection delete id " + q(name));
+				runOk("touch /tmp/es-wifi-changed");
+				return ok;
+			}, [this, name](bool ok)
+			{
+				showMessage(ok ? "Red olvidada" : "No se pudo olvidar " + corta(name, 24));
+			});
+		},
+		"CANCELAR", nullptr));
+}
+
+bool GuiPantherWifi::input(InputConfig* config, Input input)
+{
+	if (input.value == 0)
+		return true;
+
+	int count = (int)mEstado.redes.size();
+
+	if (config->isMappedTo(BUTTON_BACK, input))
+	{
+		delete this;
+		return true;
+	}
+
+	if (config->isMappedLike("up", input))
+	{
+		if (mCursor > -1)
+			mCursor--;
+	}
+	else if (config->isMappedLike("down", input))
+	{
+		if (mCursor < count - 1)
+			mCursor++;
+	}
+	else if (config->isMappedTo(BUTTON_OK, input))
+	{
+		if (mBusy)
+			showMessage("Espera un momento…", 1500);
+		else if (mCursor < 0)
+			toggle();
+		else if (mCursor < count)
+			connect(mEstado.redes[mCursor]);
+	}
+	else if (config->isMappedTo("x", input))
+	{
+		if (mBusy)
+			showMessage("Espera un momento…", 1500);
+		else if (!mEstado.activeName.empty())
+			forget();
+	}
+	else if (config->isMappedTo("y", input))
+	{
+		if (mBusy)
+			showMessage("Espera un momento…", 1500);
+		else if (mEstado.enabled)
+			refresh(true);
+	}
+
+	return true;
+}
