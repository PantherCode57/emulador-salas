+// ---- Panther OS: barra de arriba -------------------------------------------------------------
+
+void SystemView::pantherTopBarFocus(int item)
+{
+	if (mTopBar == item)
+		return;
+
+	if (mTopBar < 0 && item >= 0)
+		mTopRefresh = 0; // al entrar se pregunta enseguida por la red
+
+	mTopBar = item;
+	pantherUpdateTopLabel();
+	updateHelpPrompts();
+}
+
+void SystemView::pantherUpdateTopLabel()
+{
+	if (mTopText == nullptr)
+		return;
+
+	std::string label = "Ajustes";
+	if (mTopBar == 1)
+	{
+		std::string ssid;
+		{
+			std::lock_guard<std::mutex> lock(sPantherSsidLock);
+			ssid = sPantherSsid;
+		}
+
+		if (ssid == "?")
+			label = "Wi-Fi";
+		else if (ssid == "\x01")
+			label = "Wi-Fi · Apagado";
+		else if (ssid.empty())
+			label = "Wi-Fi · Sin conexión";
+		else
+			label = "Wi-Fi · " + ssid;
+	}
+
+	if (label != mTopLabel)
+	{
+		mTopLabel = label;
+		mTopText->setText(label);
+	}
+}
+
+void SystemView::pantherOpenTopBarItem()
+{
+	if (mTopBar == 0)
+		mWindow->pushGui(new GuiPantherAjustes(mWindow));
+	else if (mTopBar == 1)
+		mWindow->pushGui(new GuiPantherWifi(mWindow));
+}
+
+bool SystemView::pantherDirectLaunch(SystemData* system)
+{
+	if (system == nullptr || system->getRootFolder() == nullptr)
+		return false;
+
+	bool listed = false;
+	for (auto name : Utils::String::split(Settings::getInstance()->getString("PantherDirectLaunch"), ','))
+		if (Utils::String::trim(name) == system->getName())
+			listed = true;
+
+	if (!listed)
+		return false;
+
+	auto games = system->getRootFolder()->getFilesRecursive(GAME, true);
+	if (games.size() != 1)
+		return false;
+
+	ViewController::get()->launch(games.at(0));
+	return true;
+}
