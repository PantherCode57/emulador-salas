@@ -0,0 +1,26 @@
+#pragma once
+#ifndef ES_CORE_PANTHER_CAPA_H
+#define ES_CORE_PANTHER_CAPA_H
+
+#include "math/Transform4x4f.h"
+
+class Window;
+
+// Panther OS: lo que el servicio de WhatsApp de la consola pone encima del menú (ver
+// consola/emulador/capa.c, que explica el formato de /dev/shm/panther-capa):
+//  - el aviso pequeño de arriba cuando te escriben, y el chat entero si lo abres con R3;
+//  - la lista de lo que te han escrito, a la derecha de la pantalla principal (/dev/shm/panther-panel);
+//  - el recuadro de arriba a la derecha (batería, hora, WhatsApp) fuera de la pantalla principal
+//    (/dev/shm/panther-barra) y la barra del volumen de la izquierda (/dev/shm/panther-volumen).
+namespace PantherCapa
+{
+	void iniciar(Window* window);
+	void parar();
+	void activo(bool si);   // el menú está en pantalla (no mientras hay un juego abierto)
+	void actualizar();      // lee lo nuevo (hilo principal, antes de dibujar)
+	void dibujarCapa();     // lo último de todo
+	void dibujarPanel(const Transform4x4f& trans); // en la pantalla principal
+	void enInicio();         // la pantalla principal se está viendo (ahí no va el recuadro de arriba)
+}
+
+#endif
