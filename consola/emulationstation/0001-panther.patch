@@ -0,0 +1,298 @@
+#include "guis/GuiPantherAjustes.h"
+
+#include "guis/GuiPantherWifi.h"
+#include "guis/GuiTools.h"
+#include "guis/PantherEstilo.h"
+#include "guis/arkos4clone/WifiManager.h"
+#include "components/ImageComponent.h"
+#include "renderers/Renderer.h"
+#include "math/Misc.h"
+#include "utils/StringUtil.h"
+#include "AudioManager.h"
+#include "VolumeControl.h"
+#include "Window.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <fstream>
+#include <thread>
+
+// Herramientas de /opt/system que abre cada recuadro
+#define SCRIPT_INFO		"/opt/system/System Info.sh"
+#define SCRIPT_ARCHIVOS	"/opt/system/351Files.sh"
+#define SCRIPT_MANDOS	"/opt/system/Advanced/Controller Tester.sh"
+#define SCRIPT_USB_PON	"/opt/system/USB Drive Mount.sh"
+#define SCRIPT_USB_QUITA "/opt/system/USB Drive Unmount.sh"
+#define SCRIPT_PORTMASTER "/opt/system/Tools/PortMaster/PortMaster.sh"
+#define SCRIPT_COPIA	"/opt/system/Advanced/Backup dArkOS Settings.sh"
+
+enum { OP_WIFI, OP_INFO, OP_ARCHIVOS, OP_MANDOS, OP_USB, OP_PORTMASTER, OP_COPIA, OP_MAS };
+
+static bool usbMontada()
+{
+	std::ifstream f("/proc/mounts");
+	std::string linea;
+	while (std::getline(f, linea))
+		if (linea.find(" /mnt/usbdrive ") != std::string::npos)
+			return true;
+	return false;
+}
+
+GuiPantherAjustes::GuiPantherAjustes(Window* window) : GuiComponent(window),
+	mAlive(std::make_shared<bool>(true)), mCursor(0), mUsbMontada(false), mReloj(0), mFondo(nullptr), mBorde(nullptr)
+{
+	const float W = (float)Renderer::getScreenWidth();
+	const float H = (float)Renderer::getScreenHeight();
+	const float s = H / 480.0f;
+	setSize(W, H);
+
+	mLetraTitulo = PantherEstilo::letra(30 * s, "selawksb.ttf");
+	mLetraNombre = PantherEstilo::letra(18 * s, "selawksb.ttf");
+	mLetraDetalle = PantherEstilo::letra(14 * s);
+	mLetraAyuda = PantherEstilo::letra(15 * s);
+	mLetraHora = PantherEstilo::letra(26 * s, "selawksl.ttf");
+	mIconoTitulo = PantherEstilo::iconos(30 * s);
+	mIcono = PantherEstilo::iconos(20 * s);
+
+	std::string fondo = PantherEstilo::pieza("fondo-lista.jpg");
+	if (!fondo.empty())
+	{
+		mFondo = new ImageComponent(window, false);
+		mFondo->setImage(fondo);
+		mFondo->setOrigin(0, 0);
+		mFondo->setPosition(0, 0);
+		mFondo->setResize(W, H);
+	}
+
+	std::string borde = PantherEstilo::pieza("borde-ajustes.png");
+	if (!borde.empty())
+	{
+		mBorde = new ImageComponent(window, false);
+		mBorde->setImage(borde);
+		mBorde->setOrigin(0, 0);
+	}
+
+	mOpciones = {
+		{ "", 0x3B82F6FF, "Wi-Fi", "Comprobando…" },
+		{ "", 0x14A096FF, "Información", "Batería, memoria y versión" },
+		{ "", 0xE6A000FF, "Archivos", "Ver, copiar y borrar" },
+		{ "", 0x7C3AEDFF, "Mandos", "Probar los botones" },
+		{ "", 0x22A05AFF, "Memoria USB", "Conectar o quitar" },
+		{ "", 0xE66E28FF, "PortMaster", "Juegos y programas extra" },
+		{ "", 0x5A64E6FF, "Copia de seguridad", "Guardar tus ajustes" },
+		{ "", 0x6E7382FF, "Más opciones", "Todas las herramientas" },
+	};
+
+	leerEstado();
+}
+
+GuiPantherAjustes::~GuiPantherAjustes()
+{
+	*mAlive = false;
+	delete mFondo;
+	delete mBorde;
+}
+
+// Memoria USB al momento; el Wi-Fi en otro hilo (nmcli tarda un poco)
+void GuiPantherAjustes::leerEstado()
+{
+	mUsbMontada = usbMontada();
+	mOpciones[OP_USB].detalle = mUsbMontada ? "Conectada · A para quitarla" : "Conectar o quitar";
+
+	Window* window = mWindow;
+	auto alive = mAlive;
+	std::thread([this, window, alive]()
+	{
+		std::string texto = "Apagado";
+		if (WifiManager::isWifiEnabled())
+		{
+			std::string ssid = Utils::String::trim(WifiManager::getCurrentWifiSSID());
+			texto = ssid.empty() ? "Sin conexión" : ssid + " · conectado";
+		}
+
+		window->postToUiThread([this, alive, texto](Window*)
+		{
+			if (*alive)
+				mOpciones[OP_WIFI].detalle = texto;
+		});
+	}).detach();
+}
+
+// Igual que GuiTools: se suelta la pantalla y el sonido, se lanza la herramienta en la consola
+// de texto y se vuelve.
+void GuiPantherAjustes::lanzar(const std::string& script)
+{
+	AudioManager::getInstance()->deinit();
+	VolumeControl::getInstance()->deinit();
+	mWindow->deinit(true);
+
+	system("sudo chmod 666 /dev/tty1");
+	std::string cmd = "/bin/bash \"" + script + "\" 2>&1 > /dev/tty1";
+	int ret = system(cmd.c_str());
+	(void)ret;
+	system("setterm -clear all > /dev/tty1");
+
+	mWindow->init(true);
+	VolumeControl::getInstance()->init();
+	AudioManager::getInstance()->init();
+
+	mTexts.clear();
+	leerEstado();
+}
+
+void GuiPantherAjustes::abrir(int cual)
+{
+	switch (cual)
+	{
+	case OP_WIFI:		mWindow->pushGui(new GuiPantherWifi(mWindow)); break;
+	case OP_INFO:		lanzar(SCRIPT_INFO); break;
+	case OP_ARCHIVOS:	lanzar(SCRIPT_ARCHIVOS); break;
+	case OP_MANDOS:		lanzar(SCRIPT_MANDOS); break;
+	case OP_USB:		lanzar(usbMontada() ? SCRIPT_USB_QUITA : SCRIPT_USB_PON); break;
+	case OP_PORTMASTER:	lanzar(SCRIPT_PORTMASTER); break;
+	case OP_COPIA:		lanzar(SCRIPT_COPIA); break;
+	case OP_MAS:		mWindow->pushGui(new GuiTools(mWindow)); break;
+	}
+}
+
+bool GuiPantherAjustes::input(InputConfig* config, Input input)
+{
+	if (input.value == 0)
+		return true;
+
+	int n = (int)mOpciones.size();
+	if (config->isMappedTo(BUTTON_BACK, input))
+	{
+		delete this;
+		return true;
+	}
+
+	if (config->isMappedLike("left", input))
+	{
+		if (mCursor % 2 == 1)
+			mCursor--;
+	}
+	else if (config->isMappedLike("right", input))
+	{
+		if (mCursor % 2 == 0 && mCursor + 1 < n)
+			mCursor++;
+	}
+	else if (config->isMappedLike("up", input))
+	{
+		if (mCursor >= 2)
+			mCursor -= 2;
+	}
+	else if (config->isMappedLike("down", input))
+	{
+		if (mCursor + 2 < n)
+			mCursor += 2;
+	}
+	else if (config->isMappedTo(BUTTON_OK, input))
+		abrir(mCursor);
+
+	return true;
+}
+
+void GuiPantherAjustes::update(int deltaTime)
+{
+	GuiComponent::update(deltaTime);
+
+	mReloj -= deltaTime;
+	if (mReloj <= 0)
+	{
+		mReloj = 1000;
+		time_t ahora = time(0);
+		struct tm t = *localtime(&ahora);
+		char buf[16];
+		strftime(buf, sizeof(buf), "%H:%M", &t);
+		mHora = (t.tm_year > 100) ? buf : "";
+	}
+}
+
+void GuiPantherAjustes::drawText(const std::shared_ptr<Font>& font, const std::string& text, float x, float y, unsigned int color, float width, Alignment align)
+{
+	if (text.empty() || font == nullptr)
+		return;
+
+	char key[128];
+	snprintf(key, sizeof(key), "%p|%.1f|%.1f|%.1f|%d|%08x|", (void*)font.get(), x, y, width, (int)align, color);
+	std::string k = std::string(key) + text;
+
+	auto it = mTexts.find(k);
+	if (it == mTexts.end())
+	{
+		if (mTexts.size() > 80)
+			mTexts.clear();
+
+		it = mTexts.emplace(k, std::unique_ptr<TextCache>(font->buildTextCache(text, Vector2f(x, y), color, width, align, 1.0f))).first;
+	}
+
+	font->renderTextCache(it->second.get());
+}
+
+void GuiPantherAjustes::render(const Transform4x4f& parentTrans)
+{
+	const float W = (float)Renderer::getScreenWidth();
+	const float H = (float)Renderer::getScreenHeight();
+	const float sx = W / 640.0f;
+	const float sy = H / 480.0f;
+	Transform4x4f t = parentTrans * getTransform();
+
+	Renderer::setMatrix(t);
+	Renderer::drawRect(0.0f, 0.0f, W, H, 0x0B1220FF);
+	if (mFondo != nullptr)
+	{
+		mFondo->render(t);
+		Renderer::setMatrix(t);
+	}
+
+	// el texto se centra de arriba abajo en la línea que se le da
+	auto medio = [](const std::shared_ptr<Font>& f, float centro) { return Math::round(centro - f->getHeight(1.0f) / 2.0f); };
+
+	// --- Cabecera: engranaje, «Ajustes» y la hora
+	drawText(mIconoTitulo, "", 28 * sx, medio(mIconoTitulo, 40 * sy), 0xFFFFFFFF);
+	drawText(mLetraTitulo, "Ajustes", 66 * sx, medio(mLetraTitulo, 40 * sy), 0xFFFFFFFF);
+	drawText(mLetraHora, mHora, 0, medio(mLetraHora, 40 * sy), 0xFFFFFFFF, W - 24 * sx, ALIGN_RIGHT);
+
+	// --- Recuadros
+	const float tw = 290 * sx, th = 74 * sy, g = 12 * sx, gy = 12 * sy;
+	for (int k = 0; k < (int)mOpciones.size(); k++)
+	{
+		const Opcion& op = mOpciones[k];
+		float x = Math::round(24 * sx + (k % 2) * (tw + g));
+		float y = Math::round(82 * sy + (k / 2) * (th + gy));
+		bool sel = (k == mCursor);
+
+		Renderer::setMatrix(t);
+		Renderer::drawRoundRect(x, y, tw, th, 16 * sy, sel ? 0xFFFFFF3C : 0xFFFFFF22);
+
+		if (sel)
+		{
+			if (mBorde != nullptr)
+			{
+				mBorde->setResize(tw + 6 * sx, th + 6 * sy);
+				mBorde->setPosition(x - 3 * sx, y - 3 * sy);
+				mBorde->render(t);
+				Renderer::setMatrix(t);
+			}
+			else
+			{
+				// sin la pieza del borde: una franja azul arriba y abajo
+				Renderer::drawRect(x + 16 * sy, y - 3 * sy, tw - 32 * sy, 3 * sy, 0x78C8FFFF);
+				Renderer::drawRect(x + 16 * sy, y + th, tw - 32 * sy, 3 * sy, 0x78C8FFFF);
+			}
+		}
+
+		float r = 21 * sy;
+		float cx = x + 16 * sx + r, cy = y + th / 2.0f;
+		Renderer::drawRoundRect(cx - r, cy - r, r * 2, r * 2, r, op.color);
+		drawText(mIcono, op.icono, cx - r, medio(mIcono, cy), 0xFFFFFFFF, r * 2, ALIGN_CENTER);
+
+		drawText(mLetraNombre, op.nombre, x + 74 * sx, medio(mLetraNombre, y + 27 * sy), 0xFFFFFFFF);
+		drawText(mLetraDetalle, op.detalle, x + 74 * sx, medio(mLetraDetalle, y + 50 * sy), 0xC8C8D4FF);
+	}
+
+	// --- Ayuda de los botones
+	drawText(mLetraAyuda, "A  Abrir      B  Volver", 0, medio(mLetraAyuda, H - 26 * sy), 0xBEBEC8FF, W, ALIGN_CENTER);
+}
