+#pragma once
+#ifndef ES_APP_GUIS_GUIPANTHERWIFI_H
+#define ES_APP_GUIS_GUIPANTHERWIFI_H
+
+#include "GuiComponent.h"
+#include "resources/Font.h"
+
+#include <functional>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+class ImageComponent;
+class TextCache;
+
+// Panther OS: pantalla de Wi-Fi propia. Arriba el título con el interruptor, debajo la red
+// conectada y la lista de redes disponibles. A conecta, X olvida la red conectada, Y busca redes
+// y B vuelve. Todo lo que habla con NetworkManager va en otro hilo para no congelar el menú.
+class GuiPantherWifi : public GuiComponent
+{
+public:
+	struct Red
+	{
+		std::string ssid;
+		int signal = 0;
+		bool secure = false;
+		bool saved = false;
+		bool active = false;
+	};
+
+	struct Estado
+	{
+		bool enabled = false;
+		std::vector<Red> redes;
+		std::string activeName; // nombre de la conexión activa en NetworkManager
+		std::string activeSsid;
+		int activeSignal = 0;
+		std::string ip;
+	};
+
+	GuiPantherWifi(Window* window);
+	~GuiPantherWifi();
+
+	bool input(InputConfig* config, Input input) override;
+	void update(int deltaTime) override;
+	void render(const Transform4x4f& parentTrans) override;
+	std::vector<HelpPrompt> getHelpPrompts() override { return std::vector<HelpPrompt>(); }
+
+private:
+	// Trabajo en segundo plano: «work» no puede tocar la pantalla; «done» corre ya en el hilo del menú.
+	void runJob(const std::string& busyText, bool rescan, const std::function<bool()>& work, const std::function<void(bool)>& done);
+	void applyEstado(const Estado& estado);
+
+	void refresh(bool rescan);
+	void toggle();
+	void connect(const Red& red);
+	void askPassword(const std::string& ssid, bool replaceSaved);
+	void connectWithPassword(const std::string& ssid, const std::string& password, bool replaceSaved);
+	void forget();
+	void showMessage(const std::string& text, int ms = 3500);
+
+	void drawText(const std::shared_ptr<Font>& font, const std::string& text, float x, float y, unsigned int color, float width = 0, Alignment align = ALIGN_LEFT);
+	void drawSignal(float x, float y, float h, int signal, unsigned int color);
+	void drawHints(const std::vector<std::pair<std::string, std::string>>& hints, float centerX, float y);
+
+	std::shared_ptr<bool>	mAlive;
+	bool					mBusy;
+	std::string				mBusyText;
+	std::string				mMessage;
+	int						mMessageTime;
+	bool					mLoaded;
+	Estado					mEstado;
+	int						mCursor; // -1 = interruptor, 0.. = redes disponibles
+	int						mScroll;
+
+	ImageComponent*			mBackground;
+	std::shared_ptr<Font>	mFontTitle;
+	std::shared_ptr<Font>	mFontName;
+	std::shared_ptr<Font>	mFontSmall;
+	std::shared_ptr<Font>	mFontLabel;
+	std::map<std::string, std::unique_ptr<TextCache>> mTexts;
+};
+
+#endif // ES_APP_GUIS_GUIPANTHERWIFI_H
