+	mFontSmall = PantherEstilo::letra(H * 0.032f);
+	mFontLabel = PantherEstilo::letra(H * 0.029f);
+
+	std::string fondo = Settings::getInstance()->getString("PantherWifiBackground");
+	if (fondo.empty())
