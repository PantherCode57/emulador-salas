+void GuiPantherWifi::update(int deltaTime)
+{
+	GuiComponent::update(deltaTime);
+
+	if (mMessageTime > 0)
+	{
+		mMessageTime -= deltaTime;
+		if (mMessageTime <= 0)
+			mMessage.clear();
+	}
+}
