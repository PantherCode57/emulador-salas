+GuiPantherWifi::GuiPantherWifi(Window* window) : GuiComponent(window),
+	mAlive(std::make_shared<bool>(true)), mBusy(false), mMessageTime(0), mLoaded(false), mCursor(-1), mScroll(0), mBackground(nullptr)
+{
