diff --git a/es-core/src/PantherCapa.cpp b/es-core/src/PantherCapa.cpp
new file mode 100644
index 00000000..23476499
--- /dev/null
+++ b/es-core/src/PantherCapa.cpp
@@ -0,0 +1,343 @@
+#include "PantherCapa.h"
+
+#include "components/ImageComponent.h"
+#include "resources/TextureResource.h"
+#include "Window.h"
+
+#include <SDL.h>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <memory>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <thread>
+#include <time.h>
+#include <unistd.h>
+#include <vector>
+
+namespace
+{
+	const size_t CABECERA = 64;
+	const int ENTRA = 220, SALE = 260;
+
+	uint64_t ahoraMs()
+	{
+		struct timespec ts;
+		clock_gettime(CLOCK_REALTIME, &ts);
+		return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+	}
+
+	// Una de las dos imágenes compartidas, leída solo para mirar.
+	struct Mapa
+	{
+		const char* ruta;
+		uint8_t* mem = nullptr;
+		size_t tam = 0;
+		ino_t ino = 0;
+		uint64_t intento = 0, mirada = 0;
+
+		explicit Mapa(const char* r) : ruta(r) {}
+		uint32_t u32(size_t off) const { return __atomic_load_n((const uint32_t*)(mem + off), __ATOMIC_ACQUIRE); }
+
+		void soltar()
+		{
+			if (mem)
+				munmap(mem, tam);
+			mem = nullptr;
+		}
+
+		// ¿Está abierta y es la de verdad? (el servicio puede haberla vuelto a crear)
+		bool lista(uint64_t t)
+		{
+			if (!mem)
+			{
+				if (t - intento < 1000)
+					return false;
+				intento = t;
+				int fd = open(ruta, O_RDONLY | O_CLOEXEC);
+				if (fd < 0)
+					return false;
+				struct stat st;
+				if (fstat(fd, &st) == 0 && st.st_size >= (off_t)CABECERA)
+				{
+					void* m = mmap(nullptr, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd, 0);
+					if (m != MAP_FAILED)
+					{
+						mem = (uint8_t*)m;
+						tam = (size_t)st.st_size;
+						ino = st.st_ino;
+					}
+				}
+				close(fd);
+				if (!mem)
+					return false;
+			}
+			if (t - mirada > 2000)
+			{
+				mirada = t;
+				struct stat st;
+				if (stat(ruta, &st) != 0 || st.st_ino != ino)
+				{
+					soltar();
+					return false;
+				}
+			}
+			return memcmp(mem, "PCAP", 4) == 0;
+		}
+	};
+
+	// Lo que se enseña de cada una (en el hilo del menú).
+	struct Capa
+	{
+		Mapa mapa;
+		uint32_t visto = 0xffffffff;
+		uint32_t modo = 0, x = 0, y = 0, w = 0, h = 0, dura = 0;
+		uint64_t empieza = 0;
+		std::vector<unsigned char> copia;
+		std::shared_ptr<TextureResource> tex;
+		std::unique_ptr<ImageComponent> img;
+
+		explicit Capa(const char* r) : mapa(r) {}
+
+		void mirar(Window* window)
+		{
+			uint64_t t = ahoraMs();
+			if (!mapa.lista(t))
+			{
+				modo = 0;
+				visto = 0xffffffff;
+				return;
+			}
+			uint32_t n = mapa.u32(8);
+			if (n == visto || (n & 1))
+				return;
+			uint32_t m = mapa.u32(12), nw = mapa.u32(16), nh = mapa.u32(20);
+			if (m != 0 && (nw == 0 || nh == 0 || nw > 1920 || nh > 1080 || CABECERA + (size_t)nw * nh * 4 > mapa.tam))
+				return;
+			if (m != 0)
+			{
+				copia.resize((size_t)nw * nh * 4);
+				memcpy(copia.data(), mapa.mem + CABECERA, copia.size());
+			}
+			uint32_t nx = mapa.u32(24), ny = mapa.u32(28), nd = mapa.u32(40);
+			uint64_t ne = (uint64_t)mapa.u32(32) | ((uint64_t)mapa.u32(36) << 32);
+			if (mapa.u32(8) != n)
+				return; // lo estaba cambiando: a la próxima
+			visto = n;
+			modo = m, w = nw, h = nh, x = nx, y = ny, dura = nd, empieza = ne;
+			if (m == 0)
+				return;
+			tex = TextureResource::get("");
+			tex->initFromPixels(copia.data(), w, h);
+			if (!img)
+				img.reset(new ImageComponent(window));
+			img->setImage(tex);
+			img->setResize((float)w, (float)h);
+		}
+
+		bool vivo() const
+		{
+			// con el chat abierto encima, el servicio pone un latido cada segundo
+			return mapa.mem && (uint32_t)(ahoraMs() / 1000) - mapa.u32(44) <= 4;
+		}
+	};
+
+	Window* sVentana = nullptr;
+	Capa* sCapa = nullptr;
+	Capa* sPanel = nullptr;
+	Capa* sBarra = nullptr;
+	Capa* sVolumen = nullptr;
+	bool sEnInicio = false, sEnInicioAntes = false;
+	const int APAGA = 300;
+	std::atomic<bool> sActivo(true), sSalir(false), sForzar(false);
+	std::thread sHilo;
+
+	// Despierta al menú cuando hay algo nuevo (con el ahorro de energía se queda dormido esperando a
+	// que pulses algo) y le avisa al servicio de que hay alguien pintando la capa.
+	void vigilar()
+	{
+		Mapa capa("/dev/shm/panther-capa"), panel("/dev/shm/panther-panel");
+		Mapa barra("/dev/shm/panther-barra"), volumen("/dev/shm/panther-volumen");
+		uint32_t vistoCapa = 0xffffffff, vistoPanel = 0xffffffff, vistoBarra = 0xffffffff, vistoVolumen = 0xffffffff;
+		uint64_t tocado = 0;
+		while (!sSalir)
+		{
+			std::this_thread::sleep_for(std::chrono::milliseconds(40));
+			if (!sActivo)
+				continue;
+			uint64_t t = ahoraMs();
+			if (t - tocado >= 1000)
+			{
+				tocado = t;
+				int fd = open("/dev/shm/panther-capa-viendo", O_WRONLY | O_CREAT | O_CLOEXEC, 0666);
+				if (fd >= 0)
+				{
+					futimens(fd, nullptr);
+					close(fd);
+				}
+			}
+			bool despertar = false;
+			if (capa.lista(t))
+			{
+				uint32_t n = capa.u32(8);
+				if (n != vistoCapa)
+					despertar = true, vistoCapa = n;
+				uint64_t e = (uint64_t)capa.u32(32) | ((uint64_t)capa.u32(36) << 32);
+				if (capa.u32(12) == 1 && t >= e && t <= e + capa.u32(40) + SALE + 100)
+					despertar = true; // el aviso se está moviendo
+			}
+			if (panel.lista(t))
+			{
+				uint32_t n = panel.u32(8);
+				if (n != vistoPanel)
+					despertar = true, vistoPanel = n;
+			}
+			if (barra.lista(t))
+			{
+				uint32_t n = barra.u32(8);
+				if (n != vistoBarra)
+					despertar = true, vistoBarra = n;
+			}
+			if (volumen.lista(t))
+			{
+				uint32_t n = volumen.u32(8);
+				if (n != vistoVolumen)
+					despertar = true, vistoVolumen = n;
+				uint64_t e = (uint64_t)volumen.u32(32) | ((uint64_t)volumen.u32(36) << 32);
+				if (volumen.u32(12) == 1 && t >= e && t <= e + volumen.u32(40) + APAGA + 100)
+					despertar = true; // se está apagando
+			}
+			if (despertar)
+			{
+				SDL_Event ev;
+				SDL_zero(ev);
+				ev.type = SDL_USEREVENT;
+				SDL_PushEvent(&ev);
+			}
+		}
+		capa.soltar();
+		panel.soltar();
+		barra.soltar();
+		volumen.soltar();
+	}
+}
+
+namespace PantherCapa
+{
+	void iniciar(Window* window)
+	{
+		sVentana = window;
+		if (!sCapa)
+			sCapa = new Capa("/dev/shm/panther-capa");
+		if (!sPanel)
+			sPanel = new Capa("/dev/shm/panther-panel");
+		if (!sBarra)
+			sBarra = new Capa("/dev/shm/panther-barra");
+		if (!sVolumen)
+			sVolumen = new Capa("/dev/shm/panther-volumen");
+		if (!sHilo.joinable())
+		{
+			sHilo = std::thread(vigilar);
+			sHilo.detach(); // vive lo que viva el menú
+		}
+	}
+
+	void parar()
+	{
+		sSalir = true;
+	}
+
+	void activo(bool si)
+	{
+		sActivo = si;
+		if (si)
+			sForzar = true; // las texturas se han perdido con la pantalla: se vuelven a subir
+	}
+
+	void actualizar()
+	{
+		if (!sCapa || !sPanel || !sBarra || !sVolumen)
+			return;
+		if (sForzar.exchange(false))
+		{
+			sCapa->visto = sPanel->visto = sBarra->visto = sVolumen->visto = 0xffffffff;
+		}
+		sCapa->mirar(sVentana);
+		sPanel->mirar(sVentana);
+		sBarra->mirar(sVentana);
+		sVolumen->mirar(sVentana);
+		// ¿se vio la pantalla principal en la imagen anterior?
+		sEnInicioAntes = sEnInicio;
+		sEnInicio = false;
+	}
+
+	void enInicio() { sEnInicio = true; }
+
+	static void dibujarFijas()
+	{
+		Transform4x4f t = Transform4x4f::Identity();
+		bool chat = sCapa && sCapa->img && sCapa->modo == 2 && sCapa->vivo();
+		// el recuadro de arriba: en todas las pantallas menos en la principal (y no encima del chat)
+		if (sBarra && sBarra->img && sBarra->modo == 1 && !sEnInicio && !sEnInicioAntes && !chat)
+		{
+			sBarra->img->setPosition((float)sBarra->x, (float)sBarra->y);
+			sBarra->img->setOpacity(255);
+			sBarra->img->render(t);
+		}
+		// la barra del volumen: un momento y se apaga
+		if (sVolumen && sVolumen->img && sVolumen->modo == 1)
+		{
+			int64_t e = (int64_t)(ahoraMs() - sVolumen->empieza);
+			if (e < 0)
+				e = 0;
+			if (e <= (int64_t)sVolumen->dura + APAGA)
+			{
+				double a = e <= (int64_t)sVolumen->dura ? 1.0 : 1.0 - (double)(e - sVolumen->dura) / APAGA;
+				sVolumen->img->setPosition((float)sVolumen->x, (float)sVolumen->y);
+				sVolumen->img->setOpacity((unsigned char)(255 * a));
+				sVolumen->img->render(t);
+			}
+		}
+	}
+
+	void dibujarCapa()
+	{
+		dibujarFijas();
+		if (!sCapa || !sCapa->img || sCapa->modo == 0)
+			return;
+		Transform4x4f t = Transform4x4f::Identity();
+		ImageComponent* img = sCapa->img.get();
+		if (sCapa->modo == 2)
+		{
+			if (!sCapa->vivo())
+				return;
+			img->setPosition((float)sCapa->x, (float)sCapa->y);
+			img->setOpacity(255);
+			img->render(t);
+			return;
+		}
+		int64_t e = (int64_t)(ahoraMs() - sCapa->empieza);
+		if (e < 0)
+			e = 0;
+		if (e > (int64_t)sCapa->dura + SALE)
+			return;
+		double p = e < ENTRA ? (double)e / ENTRA : (e > (int64_t)sCapa->dura ? 1.0 - (double)(e - sCapa->dura) / SALE : 1.0);
+		double suave = 1 - (1 - p) * (1 - p) * (1 - p);
+		float dy = (float)((1 - suave) * (sCapa->y + sCapa->h + 6));
+		img->setPosition((float)sCapa->x, (float)sCapa->y - dy);
+		img->setOpacity((unsigned char)(255 * suave));
+		img->render(t);
+	}
+
+	void dibujarPanel(const Transform4x4f& trans)
+	{
+		if (!sPanel || !sPanel->img || sPanel->modo != 1)
+			return;
+		sPanel->img->setPosition((float)sPanel->x, (float)sPanel->y);
+		sPanel->img->setOpacity(255);
+		sPanel->img->render(trans);
+	}
+}
