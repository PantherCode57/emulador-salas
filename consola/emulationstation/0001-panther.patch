+void GuiPantherWifi::drawText(const std::shared_ptr<Font>& font, const std::string& text, float x, float y, unsigned int color, float width, Alignment align)
+{
+	if (text.empty() || font == nullptr)
+		return;
+
+	char key[128];
+	snprintf(key, sizeof(key), "%p|%.1f|%.1f|%.1f|%d|%08x|", (void*)font.get(), x, y, width, (int)align, color);
+	std::string k = std::string(key) + text;
+
+	auto it = mTexts.find(k);
+	if (it == mTexts.end())
+	{
+		if (mTexts.size() > 120)
+			mTexts.clear();
+
+		it = mTexts.emplace(k, std::unique_ptr<TextCache>(font->buildTextCache(text, Vector2f(x, y), color, width, align, 1.0f))).first;
+	}
+
+	font->renderTextCache(it->second.get());
+}
+
+void GuiPantherWifi::drawSignal(float x, float y, float h, int signal, unsigned int color)
+{
+	int bars = signal < 0 ? 0 : signal >= 75 ? 4 : signal >= 50 ? 3 : signal >= 25 ? 2 : 1;
+	float bw = h * 0.18f;
+	float gap = h * 0.1f;
+
+	for (int i = 0; i < 4; i++)
+	{
+		float bh = h * (0.35f + 0.65f * i / 3.0f);
+		unsigned int c = i < bars ? color : ((color & 0xFFFFFF00) | 0x40);
+		Renderer::drawRect(x + i * (bw + gap), y + h - bh, bw, bh, c);
+	}
+}
+
+void GuiPantherWifi::drawHints(const std::vector<std::pair<std::string, std::string>>& hints, float centerX, float y)
+{
+	float fh = mFontSmall->getHeight(1.0f);
+	float bh = fh * 1.05f;
+	float gap = bh * 0.35f;
+	float sep = bh * 1.1f;
+
+	std::vector<float> widths;
+	float total = 0;
+	for (auto& h : hints)
+	{
+		float tw = mFontSmall->sizeText(h.second, 1.0f).x();
+		widths.push_back(tw);
+		total += bh + gap + tw;
+	}
+	total += sep * (hints.size() > 0 ? hints.size() - 1 : 0);
+
+	float x = Math::round(centerX - total / 2.0f);
+	for (size_t i = 0; i < hints.size(); i++)
+	{
+		Renderer::drawRoundRect(x, y, bh, bh, bh / 2.0f, 0xFFFFFFE6);
+		drawText(mFontSmall, hints[i].first, x, y + (bh - fh) / 2.0f, 0x111827FF, bh, ALIGN_CENTER);
+		x += bh + gap;
+		drawText(mFontSmall, hints[i].second, x, y + (bh - fh) / 2.0f, 0xFFFFFFD0);
+		x += widths[i] + sep;
+	}
+}
