+#pragma once
+#ifndef ES_APP_GUIS_PANTHERESTILO_H
+#define ES_APP_GUIS_PANTHERESTILO_H
+
+#include "Settings.h"
+#include "resources/Font.h"
+#include "utils/FileSystemUtil.h"
+
+#include <string>
+
+// Panther OS: piezas compartidas por las pantallas propias (Wi-Fi, Ajustes). El ajuste
+// «PantherPiezas» es la carpeta _panther del tema (letra/, fondo-lista.jpg, bordes…).
+namespace PantherEstilo
+{
+	inline std::string pieza(const std::string& nombre)
+	{
+		std::string dir = Settings::getInstance()->getString("PantherPiezas");
+		if (dir.empty())
+			return "";
+
+		std::string ruta = dir + "/" + nombre;
+		return Utils::FileSystem::exists(ruta) ? ruta : "";
+	}
+
+	// letra/selawk.ttf (normal), selawksb.ttf (seminegrita), selawksl.ttf (semifina); si no está, la del menú
+	inline std::shared_ptr<Font> letra(float px, const char* archivo = "selawk.ttf")
+	{
+		std::string ruta = pieza(std::string("letra/") + archivo);
+		return Font::get((int)(px + 0.5f), ruta.empty() ? FONT_PATH_REGULAR : ruta);
+	}
+
+	inline std::shared_ptr<Font> iconos(float px)
+	{
+		return Font::get((int)(px + 0.5f), ":/fontawesome-webfont.ttf");
+	}
+}
+
+#endif // ES_APP_GUIS_PANTHERESTILO_H
