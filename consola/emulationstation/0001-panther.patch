@@ -0,0 +1,694 @@
+#include "guis/GuiPantherWifi.h"
+
+#include "guis/GuiMsgBox.h"
+#include "guis/GuiTextEditPopupKeyboard.h"
+#include "guis/PantherEstilo.h"
+#include "guis/arkos4clone/ArkOSUtil.h"
+#include "guis/arkos4clone/WifiManager.h"
+#include "components/ImageComponent.h"
+#include "renderers/Renderer.h"
+#include "math/Misc.h"
+#include "utils/FileSystemUtil.h"
+#include "utils/StringUtil.h"
+#include "Settings.h"
+#include "Window.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <set>
+#include <sstream>
+#include <thread>
+
+// ---- NetworkManager ------------------------------------------------------------------------
+
+static std::string q(const std::string& arg)
+{
+	return ArkOSUtil::shellQuote(arg);
+}
+
+static bool runOk(const std::string& cmd)
+{
+	return system((cmd + " >/dev/null 2>&1").c_str()) == 0;
+}
+
+static std::vector<std::string> lineas(const std::string& text)
+{
+	std::vector<std::string> out;
+	std::istringstream stream(text);
+	std::string line;
+	while (std::getline(stream, line))
+	{
+		if (!line.empty() && line.back() == '\r')
+			line.pop_back();
+
+		if (!line.empty())
+			out.push_back(line);
+	}
+	return out;
+}
+
+// nmcli -t separa con «:» y escapa «\:» y «\\»
+static std::vector<std::string> campos(const std::string& line)
+{
+	std::vector<std::string> out;
+	std::string cur;
+	for (size_t i = 0; i < line.size(); i++)
+	{
+		char c = line[i];
+		if (c == '\\' && i + 1 < line.size())
+		{
+			cur += line[++i];
+			continue;
+		}
+
+		if (c == ':')
+		{
+			out.push_back(cur);
+			cur.clear();
+			continue;
+		}
+
+		cur += c;
+	}
+	out.push_back(cur);
+	return out;
+}
+
+static GuiPantherWifi::Estado leerEstado(bool rescan)
+{
+	GuiPantherWifi::Estado e;
+	e.enabled = WifiManager::isWifiEnabled();
+	if (!e.enabled)
+		return e;
+
+	std::set<std::string> saved;
+	for (auto& line : lineas(ArkOSUtil::executeCommand("nmcli -t -f NAME,TYPE connection show 2>/dev/null")))
+	{
+		auto f = campos(line);
+		if (f.size() >= 2 && f[1] == "802-11-wireless")
+			saved.insert(f[0]);
+	}
+
+	for (auto& line : lineas(ArkOSUtil::executeCommand("nmcli -t -f NAME,TYPE connection show --active 2>/dev/null")))
+	{
+		auto f = campos(line);
+		if (f.size() >= 2 && f[1] == "802-11-wireless")
+		{
+			e.activeName = f[0];
+			break;
+		}
+	}
+
+	std::string cmd = std::string("sudo nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list --rescan ") + (rescan ? "yes" : "auto") + " 2>/dev/null";
+
+	std::vector<GuiPantherWifi::Red> redes;
+	for (auto& line : lineas(ArkOSUtil::executeCommand(cmd)))
+	{
+		auto f = campos(line);
+		if (f.size() < 4 || f[1].empty())
+			continue;
+
+		GuiPantherWifi::Red red;
+		red.ssid = f[1];
+		red.signal = atoi(f[2].c_str());
+		red.secure = !(f[3].empty() || f[3] == "--");
+		red.active = f[0].find('*') != std::string::npos;
+		red.saved = saved.count(red.ssid) > 0;
+
+		auto it = std::find_if(redes.begin(), redes.end(), [&red](const GuiPantherWifi::Red& r) { return r.ssid == red.ssid; });
+		if (it == redes.end())
+			redes.push_back(red);
+		else
+		{
+			it->signal = std::max(it->signal, red.signal);
+			it->active = it->active || red.active;
+			it->secure = it->secure || red.secure;
+		}
+	}
+
+	for (auto& red : redes)
+	{
+		if (red.active)
+		{
+			e.activeSsid = red.ssid;
+			e.activeSignal = red.signal;
+		}
+		else
+			e.redes.push_back(red);
+	}
+
+	if (e.activeSsid.empty() && !e.activeName.empty())
+	{
+		e.activeSsid = e.activeName;
+		e.activeSignal = 60;
+	}
+
+	// las guardadas primero, luego por cobertura
+	std::stable_sort(e.redes.begin(), e.redes.end(), [](const GuiPantherWifi::Red& a, const GuiPantherWifi::Red& b)
+	{
+		if (a.saved != b.saved)
+			return a.saved;
+		return a.signal > b.signal;
+	});
+
+	if (!e.activeSsid.empty())
+		e.ip = WifiManager::getIpAddress();
+
+	return e;
+}
+
+static std::string corta(const std::string& text, size_t max)
+{
+	if (text.size() <= max)
+		return text;
+
+	std::string out = text.substr(0, max);
+	while (!out.empty() && (((unsigned char)out.back()) & 0xC0) == 0x80)
+		out.pop_back();
+	if (!out.empty() && ((unsigned char)out.back()) >= 0xC0)
+		out.pop_back();
+
+	return out + "…";
+}
