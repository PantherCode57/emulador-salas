+void GuiPantherWifi::render(const Transform4x4f& parentTrans)
+{
+	const float W = (float)Renderer::getScreenWidth();
+	const float H = (float)Renderer::getScreenHeight();
+	Transform4x4f t = parentTrans * getTransform();
+
+	Renderer::setMatrix(t);
+	Renderer::drawRect(0.0f, 0.0f, W, H, 0x0B1220FF);
+
+	if (mBackground != nullptr)
+	{
+		mBackground->render(t);
+		Renderer::setMatrix(t);
+		Renderer::drawRect(0.0f, 0.0f, W, H, 0x0B1220B4);
+	}
+
+	const float mx = Math::round(W * 0.06f);
+	const float cw = W - mx * 2;
+	const float pad = Math::round(W * 0.03f);
+	const float nameH = mFontName->getHeight(1.0f);
+	const float smallH = mFontSmall->getHeight(1.0f);
+	const bool on = mEstado.enabled;
+
+	// --- Título e interruptor
+	float ty = Math::round(H * 0.05f);
+	float th = mFontTitle->getHeight(1.0f);
+	drawText(mFontTitle, "Wi-Fi", mx, ty, 0xFFFFFFFF);
+
+	float sw = Math::round(W * 0.105f);
+	float sh = Math::round(H * 0.062f);
+	float sx = mx + cw - sw;
+	float sy = Math::round(ty + (th - sh) / 2.0f);
+	if (mCursor < 0)
+	{
+		Renderer::drawRoundRect(sx - 5, sy - 5, sw + 10, sh + 10, (sh + 10) / 2.0f, 0x3B82F6FF);
+		Renderer::drawRoundRect(sx - 2, sy - 2, sw + 4, sh + 4, (sh + 4) / 2.0f, 0x0B1220FF);
+	}
+	Renderer::drawRoundRect(sx, sy, sw, sh, sh / 2.0f, on ? 0x3B82F6FF : 0x4B5563FF);
+	float k = sh - 6;
+	Renderer::drawRoundRect(on ? sx + sw - 3 - k : sx + 3, sy + 3, k, k, k / 2.0f, 0xFFFFFFFF);
+	drawText(mFontSmall, on ? "Activado" : "Desactivado", sx - W * 0.32f, sy + (sh - smallH) / 2.0f, 0xFFFFFFB0, W * 0.3f, ALIGN_RIGHT);
+
+	// --- Red conectada
+	float cy = Math::round(H * 0.165f);
+	float ch = Math::round(H * 0.15f);
+	Renderer::drawRoundRect(mx, cy, cw, ch, H * 0.025f, 0x111827E6);
+
+	bool connected = on && !mEstado.activeSsid.empty();
+	std::string name, sub;
+	if (!mLoaded)
+	{
+		name = "Wi-Fi";
+		sub = "Comprobando…";
+	}
+	else if (!on)
+	{
+		name = "Wi-Fi apagado";
+		sub = "Pulsa A en el interruptor para encenderlo";
+	}
+	else if (connected)
+		name = mEstado.activeSsid;
+	else
+	{
+		name = "Sin conexión";
+		sub = "Elige una red de la lista";
+	}
+
+	float iconH = Math::round(ch * 0.38f);
+	drawSignal(mx + pad, cy + (ch - iconH) / 2.0f, iconH, connected ? mEstado.activeSignal : -1, 0xFFFFFFFF);
+
+	float tx = mx + pad + iconH * 1.02f + pad * 0.8f;
+	float block = nameH + smallH * 1.1f;
+	float ny = Math::round(cy + (ch - block) / 2.0f);
+	float subY = Math::round(ny + nameH + smallH * 0.1f);
+	drawText(mFontName, corta(name, connected ? 22 : 30), tx, ny, 0xFFFFFFFF);
+
+	Renderer::setMatrix(t);
+	if (connected)
+	{
+		float wC = mFontSmall->sizeText("Conectado", 1.0f).x();
+		drawText(mFontSmall, "Conectado", tx, subY, 0x4ADE80FF);
+		if (!mEstado.ip.empty())
+			drawText(mFontSmall, " · IP " + mEstado.ip, tx + wC, subY, 0xFFFFFFB0);
+
+		float bh = smallH * 1.05f;
+		float hw = bh + bh * 0.35f + mFontSmall->sizeText("Olvidar", 1.0f).x();
+		drawHints({ { "X", "Olvidar" } }, mx + cw - pad - hw / 2.0f, Math::round(cy + (ch - bh) / 2.0f));
+	}
+	else
+		drawText(mFontSmall, sub, tx, subY, 0xFFFFFFB0);
+
+	// --- Redes disponibles
+	float ly = Math::round(H * 0.355f);
+	drawText(mFontLabel, "REDES DISPONIBLES", mx + 4, ly, 0xFFFFFF99);
+	if (mBusy && !mBusyText.empty())
+		drawText(mFontLabel, mBusyText, mx, ly, 0x93C5FDFF, cw - 4, ALIGN_RIGHT);
+
+	float listY = Math::round(H * 0.405f);
+	float rh = Math::round(H * 0.088f);
+	float gap = Math::round(H * 0.014f);
+	int rows = std::max(1, (int)((H * 0.885f - listY + gap) / (rh + gap)));
+	int count = (int)mEstado.redes.size();
+
+	if (mCursor >= 0)
+	{
+		if (mCursor < mScroll)
+			mScroll = mCursor;
+		if (mCursor >= mScroll + rows)
+			mScroll = mCursor - rows + 1;
+	}
+	mScroll = std::max(0, std::min(mScroll, std::max(0, count - rows)));
+
+	if (!mLoaded || !on || count == 0)
+	{
+		std::string empty = !mLoaded ? "Buscando redes…" : !on ? "Enciende el Wi-Fi para ver las redes" :
+			mBusy ? "Buscando redes…" : "No hay redes a la vista. Pulsa Y para buscar otra vez.";
+		drawText(mFontSmall, empty, mx, listY + rh * 0.6f, 0xFFFFFF99, cw, ALIGN_CENTER);
+	}
+
+	float lockW = mFontName->sizeText("", 1.0f).x();
+	for (int i = mScroll; i < std::min(count, mScroll + rows); i++)
+	{
+		const Red& red = mEstado.redes[i];
+		float ry = listY + (i - mScroll) * (rh + gap);
+		bool sel = (i == mCursor);
+
+		Renderer::setMatrix(t);
+		if (sel)
+			Renderer::drawRoundRect(mx - 3, ry - 3, cw + 6, rh + 6, H * 0.02f + 3, 0x3B82F6FF);
+		Renderer::drawRoundRect(mx, ry, cw, rh, H * 0.02f, sel ? 0x1E293BF5 : 0x111827D9);
+
+		float ih = Math::round(rh * 0.42f);
+		drawSignal(mx + pad, ry + (rh - ih) / 2.0f, ih, red.signal, 0xFFFFFFFF);
+
+		float nx = mx + pad + ih * 1.02f + pad * 0.8f;
+		drawText(mFontName, corta(red.ssid, 24), nx, Math::round(ry + (rh - nameH) / 2.0f), 0xFFFFFFFF);
+
+		float rx = mx + cw - pad;
+		if (red.secure)
+		{
+			drawText(mFontName, "", rx - lockW, Math::round(ry + (rh - nameH) / 2.0f), 0xFFFFFFC0, lockW, ALIGN_RIGHT);
+			rx -= lockW + pad * 0.6f;
+		}
+		if (red.saved)
+			drawText(mFontSmall, "Guardada", rx - W * 0.25f, Math::round(ry + (rh - smallH) / 2.0f), 0xFFFFFF88, W * 0.25f, ALIGN_RIGHT);
+	}
+
+	if (count > rows)
+	{
+		float trackH = rows * (rh + gap) - gap;
+		float thumbH = std::max(rh * 0.6f, trackH * rows / count);
+		float thumbY = listY + (trackH - thumbH) * mScroll / std::max(1, count - rows);
+		Renderer::setMatrix(t);
+		Renderer::drawRoundRect(mx + cw + 6, listY, 4, trackH, 2, 0xFFFFFF26);
+		Renderer::drawRoundRect(mx + cw + 6, thumbY, 4, thumbH, 2, 0xFFFFFFB0);
+	}
+
+	// --- Ayuda de botones o aviso
+	float hy = Math::round(H * 0.915f);
+	Renderer::setMatrix(t);
+	if (!mMessage.empty())
+	{
+		float mw = std::min(cw, mFontSmall->sizeText(mMessage, 1.0f).x() + smallH * 1.6f);
+		float mh = smallH * 1.4f;
+		float my = hy - (mh - smallH * 1.05f) / 2.0f;
+		Renderer::drawRoundRect(W / 2.0f - mw / 2.0f, my, mw, mh, mh / 2.0f, 0x000000C8);
+		drawText(mFontSmall, mMessage, W / 2.0f - mw / 2.0f, Math::round(my + (mh - smallH) / 2.0f), 0xFFFFFFFF, mw, ALIGN_CENTER);
+	}
+	else if (mCursor < 0)
+		drawHints({ { "A", on ? "Apagar" : "Encender" }, { "Y", "Buscar redes" }, { "B", "Volver" } }, W / 2.0f, hy);
+	else
+		drawHints({ { "A", "Conectar" }, { "Y", "Buscar redes" }, { "B", "Volver" } }, W / 2.0f, hy);
+}
