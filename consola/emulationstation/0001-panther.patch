+void SystemView::renderTopBar(const Transform4x4f& trans)
+{
+	if (mTopGear == nullptr || mWindow->getGuiStackSize() > 1)
+		return;
+
+	// El Wi-Fi es el icono de red de la barra de estado; el engranaje va a su izquierda.
+	Vector4f net(0, 0, 0, 0);
+	auto status = mWindow->getBatteryIndicator();
+	if (status != nullptr)
+		net = status->getNetworkIconRect();
+
+	Vector4f gear, wifi;
+	if (net.z() > 0)
+	{
+		gear = Vector4f(net.x() - net.z() * 1.6f, net.y(), net.z(), net.w());
+		wifi = net;
+	}
+	else
+	{
+		Vector3f pos = mTopGear->getPosition();
+		Vector2f sz = mTopGear->getSize();
+		gear = Vector4f(pos.x(), pos.y(), sz.x(), sz.y());
+		wifi = Vector4f(pos.x() + sz.x() * 1.6f, pos.y(), sz.x(), sz.y());
+	}
+
+	if (gear != mTopGearRect && gear.z() > 0)
+	{
+		mTopGearRect = gear;
+		mTopGear->setOrigin(0, 0);
+		mTopGear->setPosition(gear.x(), gear.y());
+		mTopGear->setResize(gear.z(), gear.w());
+	}
+
+	Transform4x4f t = Transform4x4f::Identity();
+	t.translate(Vector3f(trans.translation().x(), trans.translation().y(), 0));
+
+	if (mTopBar >= 0)
+	{
+		const Vector4f& r = (mTopBar == 0) ? gear : wifi;
+		float pad = r.w() * 0.22f;
+		float bx = r.x() - pad;
+		float by = r.y() - pad;
+		float bw = r.z() + pad * 2;
+		float bh = r.w() + pad * 2;
+
+		Renderer::setMatrix(t);
+		Renderer::drawRoundRect(bx, by, bw, bh, bh * 0.22f, 0xFFFFFF30);
+
+		if (mTopMark != nullptr)
+		{
+			if (mTopMarkSize != Vector2f(bw, bh))
+			{
+				mTopMarkSize = Vector2f(bw, bh);
+				mTopMark->setOrigin(0, 0);
+				mTopMark->setResize(bw, bh);
+			}
+
+			mTopMark->setPosition(bx, by);
+			mTopMark->render(t);
+		}
+
+		if (mTopText != nullptr && !mTopLabel.empty())
+		{
+			Vector2f ts = mTopText->getFont()->sizeText(mTopLabel);
+			float pw = ts.x() + ts.y() * 1.2f;
+			float ph = ts.y() * 1.4f;
+			float margin = Renderer::getScreenWidth() * 0.02f;
+			float px = r.x() + r.z() / 2.0f - pw / 2.0f;
+			px = Math::min(px, Renderer::getScreenWidth() - margin - pw);
+			px = Math::max(px, margin);
+			float py = by + bh + ts.y() * 0.25f;
+
+			Renderer::setMatrix(t);
+			Renderer::drawRoundRect(px, py, pw, ph, ph / 2.0f, 0x000000B8);
+
+			mTopText->setPosition(px, py);
+			mTopText->setSize(pw, ph);
+			mTopText->render(t);
+		}
+	}
+
+	mTopGear->render(t);
 }
 
