+// Panther OS: nombre de la red Wi-Fi para la etiqueta de la barra de arriba. Se pide en otro hilo
+// para no frenar el menú; «?» = todavía no se sabe, «\x01» = Wi-Fi apagado.
+static std::mutex			sPantherSsidLock;
+static std::string			sPantherSsid = "?";
+static std::atomic<bool>	sPantherSsidBusy(false);
+
+static void pantherRefreshSsid()
+{
+	if (sPantherSsidBusy.exchange(true))
+		return;
+
+	std::thread([]()
+	{
+		std::string ssid = "\x01";
+		if (WifiManager::isWifiEnabled())
+			ssid = Utils::String::trim(WifiManager::getCurrentWifiSSID());
+
+		{
+			std::lock_guard<std::mutex> lock(sPantherSsidLock);
+			sPantherSsid = ssid;
+		}
+
+		sPantherSsidBusy = false;
+	}).detach();
+}
 
