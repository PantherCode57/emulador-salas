{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pokemulador",
  "version": "0.1.0",
  "identifier": "com.panthercode.pokemulador",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pokemulador",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../emuladores/": "emuladores/"
    },
    "windows": {
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    }
  }
}
